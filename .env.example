# HOME RADAR 비밀값 예시 파일.
#
# 이 파일을 복사해서 `.env` 로 만들고 값을 채운다.
#
#   copy .env.example .env
#
# `.env` 는 .gitignore 에 들어 있어 커밋되지 않는다. `.env.example` 만 커밋한다.
# 값에 따옴표는 붙여도 되고 안 붙여도 된다.
#
# 공공데이터포털은 같은 키를 두 가지로 보여준다.
#   일반 인증키(Encoding)  — 퍼센트 인코딩된 형태 (%2B 같은 문자가 보인다)
#   일반 인증키(Decoding)  — 원문 (A-Za-z0-9+/= 만 들어 있다)
# **Decoding 키를 넣는 것을 권한다.** Encoding 키를 넣어도 HOME RADAR 가
# 한 번 풀어서 보내므로 이중 인코딩으로 인증이 깨지지는 않는다.

# LH 분양임대공고문 — https://www.data.go.kr/data/15058530/openapi.do
# 목록(15058530)과 상세(15057999) 를 각각 활용신청해야 한다.
LH_API_KEY=

# 청약홈 분양정보 — https://www.data.go.kr/data/15098547/openapi.do
# (지금은 설정만 준비돼 있고 수집기는 아직 붙이지 않았다)
APPLYHOME_API_KEY=
