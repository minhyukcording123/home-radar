# HOME RADAR 비밀값 예시 파일.
#
# 이 파일을 복사해서 `.env` 로 만들고 값을 채운다.
#
#   copy .env.example .env
#
# `.env` 는 .gitignore 에 들어 있어 커밋되지 않는다. `.env.example` 만 커밋한다.
# 값에 따옴표는 붙여도 되고 안 붙여도 된다.
#
# ──────────────────────────────────────────────────────────────────────
# 외부에 배포할 때는 이 파일을 올리지 않는다.
# 같은 이름의 값을 **호스팅 대시보드의 환경변수**에 넣는다
# (Render: Dashboard → 서비스 → Environment). render.yaml 의 `sync: false`
# 항목이 바로 그 '대시보드에서 직접 넣는 값'이다.
# ──────────────────────────────────────────────────────────────────────


# ╔════════════════════════════════════════════════════════════════════╗
# ║ 1. 공식 오픈API 키                                                  ║
# ╚════════════════════════════════════════════════════════════════════╝
#
# 공공데이터포털은 같은 키를 두 가지로 보여준다.
#   일반 인증키(Encoding)  — 퍼센트 인코딩된 형태 (%2B 같은 문자가 보인다)
#   일반 인증키(Decoding)  — 원문 (A-Za-z0-9+/= 만 들어 있다)
# **Decoding 키를 넣는 것을 권한다.** Encoding 키를 넣어도 HOME RADAR 가
# 한 번 풀어서 보내므로 이중 인코딩으로 인증이 깨지지는 않는다.
#
# 비워 두면 그 수집원만 '키 미설정'으로 건너뛴다 — 앱은 정상 동작한다.

# LH 분양임대공고문 — https://www.data.go.kr/data/15058530/openapi.do
# 목록(15058530)과 상세(15057999) 를 각각 활용신청해야 한다.
LH_API_KEY=

# 청약홈 분양정보 — https://www.data.go.kr/data/15098547/openapi.do
APPLYHOME_API_KEY=


# ╔════════════════════════════════════════════════════════════════════╗
# ║ 2. 외부 배포용 — 로그인 (개인정보 보호)                             ║
# ╚════════════════════════════════════════════════════════════════════╝
#
# 이 앱에는 생년·소득·자산·주거정보가 들어 있다.
# 외부 주소에 올리는 순간 비밀번호가 **필수**다.

# 로그인 비밀번호. 설정하면 모든 경로가 로그인 뒤로 숨는다.
# 로컬(127.0.0.1)에서만 쓸 때는 비워 둬도 된다.
# 길고 추측하기 어려운 값으로 — 다른 서비스와 같은 비밀번호를 쓰지 않는다.
APP_PASSWORD=

# "1" 이면 APP_PASSWORD 없이는 서버가 아예 뜨지 않는다.
# 배포 환경에서 켜 둔다 (render.yaml 이 자동으로 켠다).
# 개인정보가 열린 채 떠 있는 것보다 안 뜨는 게 낫다.
HR_REQUIRE_AUTH=

# 세션 쿠키 서명 키 (선택).
# 비워 두면 APP_PASSWORD 에서 유도한다 — 그래서 보통 넣을 필요가 없다.
# 넣으면: 비밀번호를 바꿔도 로그인이 유지된다.
# 안 넣으면: 비밀번호를 바꾸는 순간 모든 기기에서 로그아웃된다(보통 이게 낫다).
APP_SECRET=


# ╔════════════════════════════════════════════════════════════════════╗
# ║ 3. 외부 배포용 — 주기 수집                                          ║
# ╚════════════════════════════════════════════════════════════════════╝

# 외부 스케줄러(GitHub Actions)가 수집을 깨울 때 쓰는 토큰.
# 비워 두면 /api/cron/refresh 입구가 아예 닫힌다.
# GitHub 저장소 Secrets 의 CRON_TOKEN 과 **같은 값**이어야 한다.
CRON_TOKEN=

# 캐시가 이 시간(시)보다 오래되면 화면을 열 때 조용히 다시 수집한다.
# 0 이면 자동 갱신을 끈다. 기본 6.
HR_STALE_HOURS=


# ╔════════════════════════════════════════════════════════════════════╗
# ║ 4. 영속 저장소 — 내 조건·즐겨찾기 (Supabase 무료 Postgres)         ║
# ╚════════════════════════════════════════════════════════════════════╝
#
# Render 무료 플랜은 영구 디스크가 없어서, 파일에만 저장하면 재시작마다
# 내 조건과 즐겨찾기가 사라진다. 아래 세 값을 채우면 외부 DB에 보존되고
# PC와 아이폰이 같은 값을 본다.
#
# 세 값이 **모두** 있어야 켜진다. 하나라도 비면 예전처럼 로컬 파일만 쓴다.
#
# 표는 Supabase SQL 편집기에서 먼저 만들어야 한다:
#   python -c "from app import remote_store; print(remote_store.CREATE_TABLE_SQL)"

# Supabase 프로젝트 URL (Settings → API → Project URL)
SUPABASE_URL=

# service_role 키 (Settings → API → service_role, secret).
# ⚠ 이 키는 RLS 를 우회한다. **서버에서만** 쓰고 화면·저장소에 노출하지 않는다.
#   anon 키가 아니라 service_role 키여야 한다 (표에 RLS 가 켜져 있다).
SUPABASE_KEY=

# 개인정보를 DB에 넣기 전에 앱에서 암호화할 때 쓰는 열쇠.
# 길고 임의의 값으로. 만들기:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠ **분실하면 저장된 내 조건을 복구할 수 없다.** 비밀번호 관리자 등에 따로 보관할 것.
# ⚠ 이 값을 바꾸면 기존 레코드를 읽지 못한다 (앱이 오류로 분명히 알려 준다).
ENCRYPTION_KEY=


# ╔════════════════════════════════════════════════════════════════════╗
# ║ 5. 외부 배포용 — 저장 위치와 임시 디스크                            ║
# ╚════════════════════════════════════════════════════════════════════╝

# 공고 캐시와 내 조건을 둘 폴더.
# 호스팅에 **영구 디스크**를 붙였다면 그 마운트 경로를 넣는다 (예: /var/data).
# 그러면 재배포해도 캐시와 내 조건이 그대로 남는다.
# 비워 두면 프로젝트 안의 data/ 를 쓴다.
DATA_DIR=

# 내 조건 파일 경로를 직접 지정하고 싶을 때만 (보통 비워 둔다).
PROFILE_FILE=

# "1" 이면 '재시작하면 저장이 초기화된다'는 안내를 화면에 띄우고,
# 설정을 PROFILE_JSON 으로 복사하는 버튼을 보여준다.
# 영구 디스크가 없는 무료 플랜에서 켠다.
HR_EPHEMERAL=

# 내 조건(생년·소득·자산)의 영구 보존처 — 한 줄 JSON.
# 무료 플랜은 디스크가 임시라서, 폰에서 조건을 맞춘 뒤 앱의
# 'PROFILE_JSON 값 복사' 버튼으로 얻은 값을 여기(대시보드 환경변수)에 넣는다.
# 저장된 파일이 있으면 그쪽이 우선이고, 재시작 후에는 이 값으로 복원된다.
#
# ⚠ 개인정보다. 로컬 .env 에만 두고 저장소에는 절대 커밋하지 않는다.
PROFILE_JSON=
